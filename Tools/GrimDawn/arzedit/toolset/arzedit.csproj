<Project Sdk="Microsoft.NET.Sdk">
  <!-- Toolset build of QuasiMod arzedit (v0.2b5) — does not require VS .NET 4.5.2 targeting pack. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>arzedit</RootNamespace>
    <AssemblyName>arzedit</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\bin\</OutputPath>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\arzedit-master\arzedit\*.cs" Exclude="..\arzedit-master\arzedit\obj\**\*;..\arzedit-master\arzedit\bin\**\*" />
    <Compile Include="..\arzedit-master\arzedit\Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\arzedit-master\arzedit\App.config" Link="App.config" />
    <None Include="..\arzedit-master\arzedit\NLog.config">
      <Link>NLog.config</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="1.9.71" />
    <PackageReference Include="lz4net" Version="1.0.15.93" />
    <PackageReference Include="NLog" Version="4.4.9" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>
</Project>
