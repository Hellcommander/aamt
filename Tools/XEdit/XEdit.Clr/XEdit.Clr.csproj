    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>XEdit.Clr</RootNamespace>
    <AssemblyName>XEdit.Clr</AssemblyName>
    <Description>AI-facing CLR around TES5Edit/xEdit (TES5Edit/TES5Edit dev-4.1.6 Starfield definitions).</Description>
