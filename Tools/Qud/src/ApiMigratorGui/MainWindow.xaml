<Window x:Class="ApiMigratorGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Caves of Qud - Obsolete API Migrator" Height="760" Width="1180"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="Manual" Topmost="True" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Caves of Qud — Obsolete API Migrator" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" />

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="API dump profile:" VerticalAlignment="Center" Margin="0,0,8,0"
                       ToolTip="Which by-version obsolete dump + rewrite rules migrate uses. Pin public vs lang-beta without changing the installed game." />
            <ComboBox x:Name="ApiProfileCombo" Grid.Column="1" VerticalAlignment="Center"
                      DisplayMemberPath="Display" />
            <Button Grid.Column="2" Content="Switch" Click="SwitchApiProfile_Click"
                    Margin="8,0,8,0" Padding="10,2"
                    ToolTip="Pin the selected dump profile, or Follow Steam to clear the pin." />
            <TextBlock x:Name="ApiProfileStatusText" Grid.Column="3" VerticalAlignment="Center"
                       TextWrapping="Wrap" Foreground="#555" />
        </Grid>

        <TabControl Grid.Row="2" x:Name="MainTabs">

            <!-- ===================== MIGRATE TAB ===================== -->
            <TabItem Header="Migrate">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: options -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Scan roots" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock TextWrapping="Wrap" Foreground="#555" FontSize="11" Margin="0,0,0,8"
                                   Text="One Run covers every checked root (same as PS1 -IncludeWorkshop / multi -Path)." />

                        <TextBlock Text="Local Mods" FontWeight="SemiBold" Margin="0,0,0,2" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="LocalModsPathTextBox"
                                     ToolTip="Default local Mods folder (always scanned)" />
                            <Button Grid.Column="1" Content="Browse..." Click="BrowseLocalMods_Click"
                                    Margin="6,0,0,0" Padding="8,2" />
                        </Grid>

                        <CheckBox x:Name="IncludeWorkshopCheckBox" Content="Include Workshop"
                                  Margin="0,0,0,2"
                                  Checked="IncludeWorkshopCheckBox_Changed"
                                  Unchecked="IncludeWorkshopCheckBox_Changed"
                                  ToolTip="Same as Update-ObsoleteApis.ps1 -IncludeWorkshop / CLI --include-workshop" />
                        <TextBlock Text="Workshop" FontWeight="SemiBold" Margin="0,0,0,2" />
                        <Grid Margin="0,0,0,8" x:Name="WorkshopPathGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="WorkshopPathTextBox"
                                     ToolTip="Steam Workshop content folder for CoQ (333640)" />
                            <Button x:Name="BrowseWorkshopButton" Grid.Column="1" Content="Browse..."
                                    Click="BrowseWorkshop_Click" Margin="6,0,0,0" Padding="8,2" />
                        </Grid>

                        <TextBlock Text="Additional folders (optional)" FontWeight="SemiBold" Margin="0,4,0,2" />
                        <ListBox x:Name="PathsListBox" Height="64" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="AddFolderButton" Content="+ Browse..." Click="AddFolderButton_Click" Padding="6,2" Margin="0,0,4,0" />
                            <Button x:Name="RemovePathButton" Content="Remove" Click="RemovePathButton_Click" Padding="6,2" />
                        </StackPanel>

                        <TextBlock Text="Mod name filter (optional)" FontWeight="Bold" Margin="0,4,0,4" />
                        <TextBox x:Name="ModFilterTextBox" Margin="0,0,0,10" ToolTip="e.g. Qud Fishing - only scans paths containing this text" />

                        <CheckBox x:Name="ApplyCheckBox" Content="Apply changes (write to disk)" Margin="0,0,0,6" />
                        <CheckBox x:Name="BackupCheckBox" Content="Create .bak backups when applying" IsChecked="True" Margin="0,0,0,14" />

                        <Button x:Name="RunMigrationButton" Content="Run Migration" Click="RunMigrationButton_Click" Padding="10,6" FontWeight="Bold" HorizontalAlignment="Left"
                                ToolTip="Scans Local Mods + Workshop (if checked) + any additional folders" />
                        <Button x:Name="ApplyAllSafeAutofixesButton"
                                Content="Apply safe autofixes (Local + Workshop)"
                                Click="ApplyAllSafeAutofixesButton_Click"
                                Margin="0,8,0,0" Padding="10,6" HorizontalAlignment="Left"
                                ToolTip="Confirm, then APPLY curated safe autofixes only to Local Mods + Workshop (no .bak). Same as PS1 -IncludeWorkshop -Apply -NoBackup. Does not hand-fix leftovers." />

                        <ProgressBar x:Name="MigrateProgressBar" Height="16" Margin="0,12,0,4" Minimum="0" Maximum="100" />
                        <TextBlock x:Name="MigrateStatusText" Text="Idle." TextWrapping="Wrap" Margin="0,0,0,10" />

                        <TextBlock Text="Summary" FontWeight="Bold" Margin="0,4,0,4" />
                        <TextBlock x:Name="MigrateSummaryText" TextWrapping="Wrap" />

                        <Button x:Name="SaveReportButton" Content="Save Report As..." Click="SaveReportButton_Click" Margin="0,14,0,0" Padding="8,4" HorizontalAlignment="Left" IsEnabled="False" />
                        <Button x:Name="OpenOllamaTabButton" Content="Send leftovers to Ollama..."
                                Click="OpenOllamaTab_Click" Margin="0,8,0,0" Padding="8,4" HorizontalAlignment="Left"
                                IsEnabled="False"
                                ToolTip="Switch to the Ollama leftovers tab using the last Migrate report." />
                    </StackPanel>

                    <!-- Right: results -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*" />
                            <RowDefinition Height="3*" />
                        </Grid.RowDefinitions>

                        <GroupBox Grid.Row="0" Header="Files needing attention" Margin="0,0,0,6">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox x:Name="MigrateFilterBox" TextChanged="MigrateFilterBox_TextChanged"
                                             ToolTip="Filter by file path or leftover member" />
                                </DockPanel>
                                <DataGrid x:Name="FileResultsGrid" IsReadOnly="True" AutoGenerateColumns="False"
                                          SelectionChanged="FileResultsGrid_SelectionChanged"
                                          MouseDoubleClick="FileResultsGrid_MouseDoubleClick"
                                          GridLinesVisibility="Horizontal">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Open file" Click="OpenSelectedFile_Click" />
                                            <MenuItem Header="Open containing folder" Click="OpenSelectedFolder_Click" />
                                            <MenuItem Header="Copy path" Click="CopySelectedPath_Click" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="File" Binding="{Binding FilePath}" Width="*" />
                                        <DataGridTextColumn Header="Auto-fixes" Binding="{Binding AutoFixCount}" Width="90" />
                                        <DataGridTextColumn Header="Remaining hits" Binding="{Binding RemainingCount}" Width="110" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Grid.Row="1" Header="Details for selected file">
                            <DataGrid x:Name="DetailsGrid" IsReadOnly="True" AutoGenerateColumns="False" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="90" />
                                    <DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="50" />
                                    <DataGridTextColumn Header="Rule / Member" Binding="{Binding NameOrMember}" Width="220" />
                                    <DataGridTextColumn Header="Message / Count" Binding="{Binding Detail}" Width="220" />
                                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ===================== OBSOLETE MAP TAB ===================== -->
            <TabItem Header="Obsolete Map">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="MapInfoText" Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="MapSearchBox" Width="320" TextChanged="MapSearchBox_TextChanged" />
                        <Button x:Name="ReloadMapButton" Content="Reload from disk" Click="ReloadMapButton_Click" Margin="12,0,0,0" Padding="8,2" />
                        <Button x:Name="CompileChartsButton" Content="Compile rule charts"
                                Click="CompileChartsButton_Click" Margin="12,0,0,0" Padding="8,2"
                                ToolTip="Compile data/charts/*.xml into curated_rewrite_rules.json (edit charts, then compile)." />
                        <Button x:Name="ExportChartsButton" Content="Export charts from JSON"
                                Click="ExportChartsButton_Click" Margin="8,0,0,0" Padding="8,2"
                                ToolTip="Split curated_rewrite_rules.json into editable XML packs under data/charts/ (overwrites)." />
                        <Button x:Name="ExportPromotionsButton" Content="Export promotions"
                                Click="ExportPromotionsButton_Click" Margin="12,0,0,0" Padding="8,2"
                                ToolTip="Export needsManual dump entries to data/charts/promotions/ (merge-safe)." />
                        <Button x:Name="ApplyPromotionsButton" Content="Apply promotions"
                                Click="ApplyPromotionsButton_Click" Margin="8,0,0,0" Padding="8,2"
                                ToolTip="Apply Status=Promote + ProposedRule → Promoted.xml + dump flags + compile-rules." />
                    </StackPanel>

                    <DataGrid x:Name="MapGrid" Grid.Row="2" IsReadOnly="True" AutoGenerateColumns="False" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="260" />
                            <DataGridTextColumn Header="Member" Binding="{Binding Member}" Width="160" />
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="70" />
                            <DataGridTextColumn Header="Auto-fixable" Binding="{Binding AutoFixable}" Width="90" />
                            <DataGridTextColumn Header="Obsolete Message" Binding="{Binding ObsoleteMessage}" Width="320" />
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ===================== DLL RESEARCH TAB ===================== -->
            <TabItem Header="DLL Research">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10">
                        Reflects the game's Managed DLLs (read-only — Managed is never modified) for
                        [Obsolete] members, diffs against ApiMigrator's current obsolete map, then lets you
                        write that map back so Migrate / CS0618 Resolve / Obsolete Map pick up game updates.
                        This is how you update the ApiMigrator program after a CoQ patch.
                    </TextBlock>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Managed folder:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="ManagedDirTextBox" Grid.Column="1" />
                        <Button x:Name="BrowseManagedButton" Grid.Column="2" Content="Browse..." Click="BrowseManagedButton_Click" Margin="8,0,0,0" Padding="8,2" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="DLL file names (comma-separated):" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="DllNamesTextBox" Grid.Column="1" Text="Assembly-CSharp.dll" />
                    </Grid>

                    <StackPanel Grid.Row="3" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="ScanNowButton" Content="1. Scan Managed (read-only)" Click="ScanNowButton_Click"
                                    Padding="10,6" FontWeight="Bold"
                                    ToolTip="Reflect [Obsolete] members and show the diff. Does not write yet." />
                            <Button x:Name="SaveMergedButton"
                                    Content="2. Update ApiMigrator (save dump)"
                                    Click="SaveMergedButton_Click"
                                    Padding="10,6" Margin="10,0,0,0" IsEnabled="False" FontWeight="Bold"
                                    ToolTip="Writes obsolete_api_dump.json (with backup). Migrate / CS0618 / Obsolete Map all read this file." />
                            <ProgressBar x:Name="ResearchProgressBar" Width="200" Height="16" Margin="14,0,0,0" IsIndeterminate="False" VerticalAlignment="Center" />
                        </StackPanel>
                        <CheckBox x:Name="ResearchWriteReportCheckBox" Content="Also write research report to _tools/reports/"
                                  IsChecked="True" Margin="0,0,0,6"
                                  ToolTip="Markdown summary of added / changed / removed obsolete APIs" />
                        <TextBlock x:Name="ResearchDumpPathText" Margin="0,0,0,6" TextWrapping="Wrap" Foreground="#555" FontSize="11" />
                        <TextBlock x:Name="ResearchStatusText" Text="Idle. Scan first, then Update ApiMigrator to apply the dump." Margin="0,0,0,8" TextWrapping="Wrap" />
                        <TextBlock x:Name="ResearchSummaryText" Margin="0,0,0,8" TextWrapping="Wrap" FontWeight="Bold" />
                    </StackPanel>

                    <DataGrid Grid.Row="4" x:Name="DiffGrid" IsReadOnly="True" AutoGenerateColumns="False" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Change" Binding="{Binding Change}" Width="80" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="260" />
                            <DataGridTextColumn Header="Member" Binding="{Binding Member}" Width="160" />
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ===================== OLLAMA TAB ===================== -->
            <TabItem Header="Ollama leftovers">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                            After a Migrate run, send leftover DidX / GameText hits to Ollama
                            for C# rewrites (not advice). Nothing is written unless you Apply.
                            Local default: start Ollama (ollama serve). Optional cloud: ollama.com
                            with an API key, or pull a local *-cloud model after ollama signin.
                        </TextBlock>

                        <CheckBox x:Name="OllamaUseCloudCheck" Content="Use Ollama Cloud (ollama.com)"
                                  Margin="0,0,0,8"
                                  Checked="OllamaUseCloud_Changed"
                                  Unchecked="OllamaUseCloud_Changed"
                                  ToolTip="Direct https://ollama.com API. Unchecked = localhost (including pulled *-cloud models)." />
                        <StackPanel x:Name="OllamaCloudPanel" Visibility="Collapsed" Margin="0,0,0,8">
                            <TextBlock Text="API key" FontWeight="Bold" Margin="0,0,0,4" />
                            <PasswordBox x:Name="OllamaApiKeyBox" Margin="0,0,0,4"
                                         ToolTip="Leave blank to use the OLLAMA_API_KEY environment variable. Create a key at ollama.com/settings/keys." />
                            <TextBlock x:Name="OllamaApiKeyHint" TextWrapping="Wrap" Foreground="#555" FontSize="11" Margin="0,0,0,4" />
                            <CheckBox x:Name="OllamaRememberKeyCheck" Content="Remember API key on this machine"
                                      ToolTip="Stores the key in _tools/data/gui-settings.json. Leave off to use the env var only." />
                            <TextBlock x:Name="OllamaFreeModelsHint" TextWrapping="Wrap" Foreground="#555" FontSize="11" Margin="0,6,0,0" />
                        </StackPanel>

                        <TextBlock Text="Host" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBox x:Name="OllamaUrlBox" Margin="0,0,0,8" Text="http://localhost:11434" />

                        <TextBlock Text="Model" FontWeight="Bold" Margin="0,0,0,4" />
                        <ComboBox x:Name="OllamaModelCombo" IsEditable="True" Margin="0,0,0,4"
                                  SelectionChanged="OllamaModelCombo_SelectionChanged"
                                  LostFocus="OllamaModelCombo_Changed"
                                  ToolTip="Cloud leftover default is gpt-oss:20b (fast code/JSON). Use 120b for hard hits, Gemma-4 for multimodal, Nemotron Super/Ultra for long multi-step." />
                        <TextBlock x:Name="OllamaModelCapabilityText" TextWrapping="Wrap" Foreground="#444" FontSize="11" Margin="0,0,0,8" />

                        <TextBlock Text="Max hits per run" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBox x:Name="OllamaMaxBox" Margin="0,0,0,8" Text="12" Width="80" HorizontalAlignment="Left" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Probe Ollama" Click="OllamaProbe_Click" Padding="8,4" Margin="0,0,8,0"
                                    ToolTip="GET /api/tags — list installed models and fill the combo." />
                            <Button x:Name="OllamaSuggestButton" Content="Rewrite leftovers"
                                    Click="OllamaSuggest_Click" Padding="8,4" FontWeight="Bold"
                                    ToolTip="Uses the last Migrate report. The model must emit C# replacements, not advice. Run Migrate first (dry-run is fine)." />
                            <Button x:Name="OllamaCancelButton" Content="Cancel"
                                    Click="OllamaCancel_Click" Padding="8,4" IsEnabled="False"
                                    ToolTip="Stop the current leftover suggest run." />
                        </StackPanel>

                        <ProgressBar x:Name="OllamaProgressBar" Height="16" Margin="0,0,0,4" Minimum="0" Maximum="100" />
                        <TextBlock x:Name="OllamaStatusText" Text="Idle. Probe to list models." TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock x:Name="OllamaSummaryText" TextWrapping="Wrap" FontWeight="Bold" Margin="0,0,0,10" />

                        <Button Content="Apply selected suggestion" Click="OllamaApplySelected_Click"
                                Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,6"
                                ToolTip="Replaces the original line in the file when it occurs exactly once." />
                        <Button Content="Apply rewrite rows (high+medium)" Click="OllamaApplyHighConfidence_Click"
                                Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,6"
                                ToolTip="Writes non-skip C# replacements with confidence high or medium (unique original line only). Low and advisory rows stay." />
                        <Button Content="Save suggestions report..." Click="OllamaSaveReport_Click"
                                Padding="8,4" HorizontalAlignment="Left" />
                    </StackPanel>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="2*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="OllamaFilterBox" TextChanged="OllamaFilterBox_TextChanged"
                                     ToolTip="Filter by file, member, original, or suggestion text" />
                        </DockPanel>
                        <DataGrid x:Name="OllamaGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False"
                                  GridLinesVisibility="Horizontal"
                                  SelectionChanged="OllamaGrid_SelectionChanged"
                                  MouseDoubleClick="OllamaGrid_MouseDoubleClick">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Open file" Click="OllamaOpenFile_Click" />
                                    <MenuItem Header="Copy original" Click="OllamaCopyOriginal_Click" />
                                    <MenuItem Header="Copy suggestion" Click="OllamaCopyReplacement_Click" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="60" />
                                <DataGridTextColumn Header="Conf" Binding="{Binding Confidence}" Width="55" />
                                <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="140" />
                                <DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="50" />
                                <DataGridTextColumn Header="Member" Binding="{Binding Member}" Width="160" />
                                <DataGridTextColumn Header="Original" Binding="{Binding Original}" Width="180" />
                                <DataGridTextColumn Header="Suggested" Binding="{Binding Replacement}" Width="*" />
                                <DataGridTextColumn Header="Why" Binding="{Binding Explanation}" Width="160" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <GroupBox Grid.Column="0" Header="Original" Margin="0,0,4,0">
                                <TextBox x:Name="OllamaOriginalBox" IsReadOnly="True" TextWrapping="Wrap"
                                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" FontSize="12" BorderThickness="0" />
                            </GroupBox>
                            <GroupBox Grid.Column="1" Header="Suggested replacement" Margin="4,0,0,0">
                                <TextBox x:Name="OllamaReplacementBox" IsReadOnly="True" TextWrapping="Wrap"
                                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" FontSize="12" BorderThickness="0" />
                            </GroupBox>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ===================== CS0618 TAB ===================== -->
            <TabItem Header="CS0618 Resolve">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                            Harvest CS0618 obsolete warnings without launching the game
                            (compile against Managed takes seconds). Then auto-apply curated
                            rewrites and list what still needs EmitMessage / GameText work.
                        </TextBlock>

                        <TextBlock Text="Mod folder" FontWeight="Bold" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="Cs0618ModFolderTextBox" />
                            <Button Grid.Column="1" Content="Browse..." Click="Cs0618BrowseMod_Click" Margin="6,0,0,0" Padding="8,2" />
                        </Grid>

                        <TextBlock Text="Managed folder" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBox x:Name="Cs0618ManagedTextBox" Margin="0,0,0,8" />

                        <TextBlock Text="Optional: paste / load warning log" FontWeight="Bold" Margin="0,4,0,4" />
                        <TextBox x:Name="Cs0618PasteBox" Height="90" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,4"
                                 ToolTip="Paste compiler CS0618 lines or MODWARN snippets here" />
                        <Button Content="Load log file..." Click="Cs0618LoadLog_Click" Padding="8,2" HorizontalAlignment="Left" Margin="0,0,0,10" />

                        <CheckBox x:Name="Cs0618CompileCheckBox" Content="Compile mod against Managed" IsChecked="True" Margin="0,0,0,4" />
                        <CheckBox x:Name="Cs0618ApplyCheckBox" Content="Apply curated auto-fixes" Margin="0,0,0,4" />
                        <CheckBox x:Name="Cs0618BackupCheckBox" Content="Create .bak backups" IsChecked="True" Margin="0,0,0,12" />

                        <Button x:Name="Cs0618RunButton" Content="Resolve CS0618" Click="Cs0618Run_Click"
                                Padding="10,6" FontWeight="Bold" HorizontalAlignment="Left" />
                        <ProgressBar x:Name="Cs0618ProgressBar" Height="16" Margin="0,12,0,4" IsIndeterminate="False" />
                        <TextBlock x:Name="Cs0618StatusText" Text="Idle." TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock x:Name="Cs0618SummaryText" TextWrapping="Wrap" FontWeight="Bold" />
                    </StackPanel>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <GroupBox Grid.Row="0" Header="Harvested CS0618 (by symbol)" Margin="0,0,0,6">
                            <DataGrid x:Name="Cs0618SymbolGrid" IsReadOnly="True" AutoGenerateColumns="False" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="60" />
                                    <DataGridTextColumn Header="Obsolete symbol" Binding="{Binding Symbol}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                        <GroupBox Grid.Row="1" Header="Warning details">
                            <DataGrid x:Name="Cs0618WarningGrid" IsReadOnly="True" AutoGenerateColumns="False" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="File" Binding="{Binding File}" Width="220" />
                                    <DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="50" />
                                    <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="200" />
                                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ===================== CP437 → UTF16 TAB ===================== -->
            <TabItem Header="CP437 → UTF16">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                            Converts legacy CP437 code points in .cs / .xml to UTF-16 glyphs
                            (ConsoleLib.Console.CP437). Also sets Encoding="utf-8" on XML roots
                            when glyphs were converted. Named escapes \t \a \b \v \f are flagged
                            for review unless you enable ambiguous conversion.
                        </TextBlock>

                        <TextBlock Text="Scan roots" FontWeight="Bold" Margin="0,0,0,4" />
                        <ListBox x:Name="Cp437PathsListBox" Height="100" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="+ Local Mods" Click="Cp437AddMods_Click" Padding="6,2" Margin="0,0,4,0" />
                            <Button Content="+ Workshop" Click="Cp437AddWorkshop_Click" Padding="6,2" Margin="0,0,4,0" />
                            <Button Content="+ Browse..." Click="Cp437AddFolder_Click" Padding="6,2" Margin="0,0,4,0" />
                            <Button Content="Remove" Click="Cp437RemovePath_Click" Padding="6,2" />
                        </StackPanel>

                        <TextBlock Text="Mod name filter (optional)" FontWeight="Bold" Margin="0,4,0,4" />
                        <TextBox x:Name="Cp437ModFilterTextBox" Margin="0,0,0,10" />

                        <CheckBox x:Name="Cp437ApplyCheckBox" Content="Apply changes (write to disk)" Margin="0,0,0,4" />
                        <CheckBox x:Name="Cp437BackupCheckBox" Content="Create .bak backups when applying" IsChecked="True" Margin="0,0,0,4" />
                        <CheckBox x:Name="Cp437AmbiguousCheckBox" Content="Convert ambiguous \t \a \b \v \f escapes" Margin="0,0,0,4" />
                        <CheckBox x:Name="Cp437ForceUtf8CheckBox" Content="Force Encoding=&quot;utf-8&quot; on all XML roots" Margin="0,0,0,8" />

                        <Button x:Name="Cp437RunButton" Content="Convert CP437 → UTF16" Click="Cp437Run_Click"
                                Padding="10,6" FontWeight="Bold" HorizontalAlignment="Left" />

                        <ProgressBar x:Name="Cp437ProgressBar" Height="16" Margin="0,12,0,4" Minimum="0" Maximum="100" />
                        <TextBlock x:Name="Cp437StatusText" Text="Idle." TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock x:Name="Cp437SummaryText" TextWrapping="Wrap" FontWeight="Bold" Margin="0,0,0,10" />
                        <Button x:Name="Cp437SaveReportButton" Content="Save Report As..." Click="Cp437SaveReport_Click"
                                Padding="8,4" HorizontalAlignment="Left" IsEnabled="False" />
                    </StackPanel>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*" />
                            <RowDefinition Height="3*" />
                        </Grid.RowDefinitions>
                        <GroupBox Grid.Row="0" Header="Files with CP437 hits" Margin="0,0,0,6">
                            <DataGrid x:Name="Cp437FileGrid" IsReadOnly="True" AutoGenerateColumns="False"
                                      SelectionChanged="Cp437FileGrid_SelectionChanged" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="File" Binding="{Binding FilePath}" Width="*" />
                                    <DataGridTextColumn Header="Auto-fixes" Binding="{Binding AutoFixCount}" Width="90" />
                                    <DataGridTextColumn Header="Review" Binding="{Binding ReviewCount}" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                        <GroupBox Grid.Row="1" Header="Hits for selected file">
                            <DataGrid x:Name="Cp437HitGrid" IsReadOnly="True" AutoGenerateColumns="False" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="50" />
                                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="120" />
                                    <DataGridTextColumn Header="From" Binding="{Binding From}" Width="120" />
                                    <DataGridTextColumn Header="To" Binding="{Binding To}" Width="120" />
                                    <DataGridTextColumn Header="Auto" Binding="{Binding Auto}" Width="50" />
                                    <DataGridTextColumn Header="Review" Binding="{Binding Review}" Width="55" />
                                    <DataGridTextColumn Header="Context" Binding="{Binding Context}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
