<Project>
  <!-- ApiMigrator tools are Windows x64 only (not AnyCPU / Prefer32Bit). -->
  <PropertyGroup>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Platforms>x64</Platforms>
    <!-- Concurrent PS1 / CLI / GUI runs often have a previous output DLL still mapped. -->
    <CopyRetryCount>30</CopyRetryCount>
    <CopyRetryDelayMilliseconds>500</CopyRetryDelayMilliseconds>
  </PropertyGroup>
</Project>
