<Project Sdk="Microsoft.NET.Sdk">

  <!-- Audio Bench: a Windows program that hosts the toolkit's audio bench page. It finds the toolkit and its Python,
       starts Tools/Shared/audio_bench_server.py from the repo, and shows the page in its own window with the server log.
       Build: dotnet build -c Release  (the exe is copied to Tools\AudioBench.exe). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>AudioBench</AssemblyName>
    <RootNamespace>AAMT.AudioBench</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.0.0</Version>
    <Product>AAMT Audio Bench</Product>
    <Description>Programmatic mixing, blending and sound shaping with a control-panel page; the toolkit's bench server runs underneath.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2420.47" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <!-- The exe and the WebView2 loader go next to the launcher .bat files, so Tools\AudioBench.exe just runs. -->
  <Target Name="CopyToTools" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)Microsoft.Web.WebView2.Core.dll;$(TargetDir)Microsoft.Web.WebView2.WinForms.dll;$(TargetDir)runtimes\win-x64\native\WebView2Loader.dll" DestinationFolder="$(MSBuildThisFileDirectory).." ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
