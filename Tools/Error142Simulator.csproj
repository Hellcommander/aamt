<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <StartupObject>Error142Simulator.Error142Simulator</StartupObject>
    <OutputPath>$(MSBuildThisFileDirectory)TerrariaMods\bin\$(Configuration)\$(TargetFramework)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Error142Analyzer.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference compiled tModLoader.dll for Terraria namespaces -->
    <Reference Include="tModLoader">
      <HintPath>E:\SteamLibrary\steamapps\common\tModLoader\tModLoader.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Reference required tModLoader dependencies -->
    <PackageReference Include="Ionic.Zlib" Version="1.9.1.5" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

</Project>

