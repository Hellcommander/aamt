  "views": [
    {
      "name": "extras",
      "title": "Mad Science",
      "description": "Threading, diagnostics, and Data folder watcher.",
      "hub": true,
      "sections": [
        {
          "title": "Threading",
          "rows": [
            {
              "kind": "toggle",
              "label": "Worker threads",
              "setting": "Threading.Enabled"
            },
            {
              "kind": "slider",
              "label": "Worker count",
              "hint": "0 leaves one core for the game.",
              "setting": "Threading.WorkerThreadCount",
              "min": 0,
              "max": 8,
              "step": 1
            }
          ]
        },
        {
          "title": "Diagnostics",
          "rows": [
            {
              "kind": "toggle",
              "label": "Record diagnostics",
              "setting": "RecordDiagnostics.Enabled"
            },
            {
              "kind": "toggle",
              "label": "Data folder watcher",
              "setting": "FileChangeNotify.Enabled"
            },
            {
              "kind": "text",
              "text": "AOB engine patches stay off unless you turn General.Enabled on. Leave that off if Engine Fixes is installed."
            }
          ]
        }
      ]
    }
  ],
  "accent": "#E07A3D"
