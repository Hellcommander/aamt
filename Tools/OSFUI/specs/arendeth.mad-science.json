{
  "modId": "arendeth.mad-science",
  "title": "Mad Science",
  "description": "Shared engine extras for the magic collection.",
  "version": 1,
  "source": {
    "ini": "SFSE/Plugins/MadScience.ini"
  },
  "settings": {
    "groups": [
      {
        "id": "general",
        "label": "General",
        "settings": [
          {
            "key": "General.Enabled",
            "label": "Enabled",
            "type": "bool",
            "default": false,
            "hint": "Master switch for the AOB patch engine only (FileHandleLimit, PapyrusLimits, BA2, ...). false = do not write Starfield.exe. Leave this off if Engine Fixes is installed."
          },
          {
            "key": "General.RespectEngineFixes",
            "label": "Respect Engine Fixes",
            "type": "bool",
            "default": true,
            "hint": "If Starfield Engine Fixes is loaded, skip AOB features that overlap with it."
          }
        ]
      },
      {
        "id": "threading",
        "label": "Threading",
        "settings": [
          {
            "key": "Threading.Enabled",
            "label": "Enabled",
            "type": "bool",
            "default": true
          },
          {
            "key": "Threading.WorkerThreadCount",
            "label": "Worker Thread Count",
            "type": "int",
            "default": 0,
            "min": 0,
            "max": 10,
            "step": 1,
            "hint": "0 = hardware_concurrency - 1 (leaves one core for the game). Cap is 8."
          },
          {
            "key": "Threading.MaxQueuedJobs",
            "label": "Max Queued Jobs",
            "type": "int",
            "default": 4096,
            "min": 0,
            "max": 16384,
            "step": 1
          },
          {
            "key": "Threading.MaxResultsPerTick",
            "label": "Max Results Per Tick",
            "type": "int",
            "default": 32,
            "min": 0,
            "max": 128,
            "step": 1,
            "hint": "Apply at most this many finished jobs per frame so a burst cannot hitch."
          }
        ]
      },
      {
        "id": "filechanges",
        "label": "FileChanges",
        "settings": [
          {
            "key": "FileChanges.Enabled",
            "label": "Enabled",
            "type": "bool",
            "default": false
          },
          {
            "key": "FileChanges.MaxStdio",
            "label": "Max Stdio",
            "type": "int",
            "default": 2048,
            "min": 0,
            "max": 8192,
            "step": 1
          }
        ]
      },
      {
        "id": "recorddiagnostics",
        "label": "RecordDiagnostics",
        "settings": [
          {
            "key": "RecordDiagnostics.Enabled",
            "label": "Enabled",
            "type": "bool",
            "default": true
          },
          {
            "key": "RecordDiagnostics.WarnHandlePercent",
            "label": "Warn Handle Percent",
            "type": "int",
            "default": 90,
            "min": 0,
            "max": 360,
            "step": 1,
            "hint": "Warn when nativeHandle count or REFR+ACHR count reaches this % of 2,097,152."
          },
          {
            "key": "RecordDiagnostics.WarnCreatedLocalId",
            "label": "Warn Created Local Id",
            "type": "string",
            "default": "0x400000",
            "maxLength": 64,
            "hint": "Warn when the highest runtime-created local FormID reaches this (0x400000 is the community \"saves start dying\" zone; format max is 0xFFFFFE)."
          }
        ]
      },
      {
        "id": "filechangenotify",
        "label": "FileChangeNotify",
        "settings": [
          {
            "key": "FileChangeNotify.Enabled",
            "label": "Enabled",
            "type": "bool",
            "default": true
          },
          {
            "key": "FileChangeNotify.BufferBytes",
            "label": "Buffer Bytes",
            "type": "int",
            "default": 262144,
            "min": 0,
            "max": 1048576,
            "step": 1
          },
          {
            "key": "FileChangeNotify.Signature",
            "label": "Signature",
            "type": "string",
            "default": "",
            "maxLength": 64,
            "hint": "Blank = built-in 1.16.x signature. Override only if a game update moves it."
          }
        ]
      },
      {
        "id": "filehandlelimit",
